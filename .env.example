# Demo mode: built-in mock listings + pre-baked verdicts (no keys needed).
# Set to false for live Amazon.in scans.
USE_MOCK_DATA=true

# --- Live mode: data source (pick one) ---
# Free: Apify directly (apify.com free plan). Token from Apify Console > Settings > Integrations.
APIFY_TOKEN=
# Optional overrides
APIFY_ACTOR=junglee/Amazon-crawler
APIFY_MAX_ITEMS=15
# Or: an n8n webhook that returns { listings: [...] } (takes priority over APIFY_TOKEN when set)
N8N_WEBHOOK_URL=

# --- Live mode: classifier ---
# Leave empty to use the FREE rule checks (brand spelling, price, title; photos not compared).
# Set to use Claude vision + text instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
